# Copy to .env and adjust. Values match control-plane/scripts/create_local_db.sql.
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://zipzy:zipzy@127.0.0.1:5432/zipzy_dba
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Access-token signing secret: 32+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# false only for local http://localhost; must be true anywhere with HTTPS
COOKIE_SECURE=false

# Local shortcut: sign in by sending X-Dev-User: <email>. Never enabled outside development.
DEV_AUTH=true

# Dashboard URL(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:3000

# Used only by the test suite
TEST_DATABASE_URL=postgresql+asyncpg://zipzy:zipzy@127.0.0.1:5432/zipzy_dba_test
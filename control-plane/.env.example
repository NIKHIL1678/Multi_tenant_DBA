# Copy to .env and adjust. Values match control-plane/scripts/create_local_db.sql.
APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://zipzy:zipzy@127.0.0.1:5432/zipzy_dba
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Used only by the test suite
TEST_DATABASE_URL=postgresql+asyncpg://zipzy:zipzy@127.0.0.1:5432/zipzy_dba_test